# ~/.bashrc — crafted for control@controlplane
# ============================================================
#  If not running interactively, don't do anything
# ============================================================
case $- in
    *i*) ;;
      *) return;;
esac

# ============================================================
#  Filesystem guard — stay on fast ext4, not slow /mnt/c (9P)
#  Interactive shells only (above return keeps scripts safe).
#  If a shell starts inside the Windows filesystem, hop home.
# ============================================================
case "$PWD" in
    /mnt/*)
        cd "$HOME"
        echo -e "\e[2m(hopped from Windows drive to \$HOME for fast ext4 I/O)\e[0m"
        ;;
esac

# ============================================================
#  PATH — put Claude Code + user binaries first
# ============================================================
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/bin:$PATH"

# ============================================================
#  Prompt-integration hooks — MUST run before starship/zoxide.
#  direnv (apt build) parses PROMPT_COMMAND unquoted, so it has
#  to hook while PROMPT_COMMAND is still empty. Order matters:
#    direnv -> atuin -> (later) zoxide -> (last) starship
# ============================================================
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook bash)"
command -v atuin  >/dev/null 2>&1 && eval "$(atuin init bash)"

# ============================================================
#  History — big, deduped, shared across shells
# ============================================================
HISTCONTROL=ignoreboth        # no dupes, no lines starting with space
HISTSIZE=100000
HISTFILESIZE=200000
HISTTIMEFORMAT="%F %T  "       # timestamp every command
shopt -s histappend            # append, don't overwrite
shopt -s cmdhist               # multiline commands as one entry

# ============================================================
#  Shell behavior niceties
# ============================================================
shopt -s checkwinsize          # keep LINES/COLUMNS correct after resize
shopt -s autocd 2>/dev/null    # type a dir name to cd into it
shopt -s cdspell 2>/dev/null   # autocorrect minor cd typos
shopt -s dirspell 2>/dev/null
shopt -s globstar 2>/dev/null  # ** matches recursively

# make less friendly for non-text files
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# ============================================================
#  Colors — dircolors + LS_COLORS metadata coloring
# ============================================================
if [ -x /usr/bin/dircolors ]; then
    eval "$(dircolors -b)"
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
    alias ip='ip --color=auto'
fi
export CLICOLOR=1
export LS_COLORS="$LS_COLORS:di=1;34:ln=1;36:ex=1;32:*.tar=1;31:*.zip=1;31:*.gz=1;31:*.md=1;33:*.json=0;33:*.sh=1;32"
# colored man pages
export LESS_TERMCAP_mb=$'\e[1;31m'
export LESS_TERMCAP_md=$'\e[1;36m'
export LESS_TERMCAP_me=$'\e[0m'
export LESS_TERMCAP_se=$'\e[0m'
export LESS_TERMCAP_so=$'\e[1;44;33m'
export LESS_TERMCAP_ue=$'\e[0m'
export LESS_TERMCAP_us=$'\e[1;32m'

# ============================================================
#  Fallback git-aware prompt (only used if starship is absent)
#    ✚ staged   ✱ modified   …untracked   ⇡ahead ⇣behind   ✔ clean
# ============================================================
__git_prompt() {
    local branch
    branch=$(git symbolic-ref --short HEAD 2>/dev/null) \
        || branch=$(git rev-parse --short HEAD 2>/dev/null) \
        || return 0
    local staged=" " unstaged=" " untracked=" " state=""
    git diff --cached --quiet 2>/dev/null || staged="\[\e[1;32m\]✚\[\e[0m\]"
    git diff --quiet 2>/dev/null          || unstaged="\[\e[1;33m\]✱\[\e[0m\]"
    [ -n "$(git ls-files --others --exclude-standard 2>/dev/null)" ] \
        && untracked="\[\e[1;31m\]…\[\e[0m\]"
    local ab
    ab=$(git rev-list --left-right --count '@{upstream}...HEAD' 2>/dev/null)
    if [ -n "$ab" ]; then
        local behind=${ab%%[[:space:]]*} ahead=${ab##*[[:space:]]}
        [ "$behind" -gt 0 ] 2>/dev/null && state+="\[\e[1;35m\]⇣$behind\[\e[0m\]"
        [ "$ahead"  -gt 0 ] 2>/dev/null && state+="\[\e[1;35m\]⇡$ahead\[\e[0m\]"
    fi
    local dirty="$staged$unstaged$untracked"
    if [ "$dirty" = "   " ]; then dirty="\[\e[1;32m\]✔\[\e[0m\]"; fi
    printf ' \[\e[0m\]on \[\e[1;36m\]⎇ %s\[\e[0m\] %s%s' "$branch" "$dirty" "$state"
}
__exit_face() {
    if [ $1 -eq 0 ]; then printf '\[\e[1;32m\]➜\[\e[0m\]';
    else printf '\[\e[1;31m\]➜\[\e[0m\]'; fi
}
__set_prompt() {
    local ec=$?
    PS1='\[\e[1;32m\]\u\[\e[0m\]@\[\e[1;33m\]\h\[\e[0m\] \[\e[1;34m\]\w\[\e[0m\]'
    PS1+="$(__git_prompt)"
    PS1+='\n'"$(__exit_face $ec)"' '
}

# ============================================================
#  Aliases — navigation & everyday
# ============================================================
alias ll='ls -alhF'
alias la='ls -A'
alias l='ls -CF'
alias lt='ls -alhFt'
alias lS='ls -alhFS'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias mkdir='mkdir -pv'
alias cp='cp -iv'
alias mv='mv -iv'
alias rm='rm -Iv'
alias df='df -h'
alias du='du -h'
alias free='free -h'
alias path='echo -e "${PATH//:/\n}"'
alias reload='source ~/.bashrc && echo "✔ reloaded ~/.bashrc"'

# default ls with colors + dirs first (overridden by eza below if present)
alias ls='ls --color=auto --group-directories-first'

# modern-tool aliases (only take effect if the tool is installed)
command -v batcat  >/dev/null 2>&1 && alias cat='batcat --paging=never'
command -v bat     >/dev/null 2>&1 && alias cat='bat --paging=never'
command -v eza     >/dev/null 2>&1 && alias ls='eza --group-directories-first --icons'
command -v eza     >/dev/null 2>&1 && alias ll='eza -alhF --git --icons --group-directories-first'
command -v eza     >/dev/null 2>&1 && alias lt='eza -alhF --git --icons --sort=modified'
command -v eza     >/dev/null 2>&1 && alias tree='eza --tree --icons'
command -v fdfind  >/dev/null 2>&1 && alias fd='fdfind'
command -v zoxide  >/dev/null 2>&1 && eval "$(zoxide init bash)"   # z <partial-dir>
if command -v fzf >/dev/null 2>&1; then
    [ -f /usr/share/doc/fzf/examples/key-bindings.bash ] && . /usr/share/doc/fzf/examples/key-bindings.bash
fi

# ============================================================
#  Aliases — git shortcuts
# ============================================================
alias gs='git status -sb'
alias ga='git add'
alias gaa='git add --all'
alias gc='git commit -m'
alias gca='git commit -am'
alias gp='git push'
alias gpl='git pull'
alias gco='git checkout'
alias gb='git branch'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate --all -20'
alias glog='git log --graph --pretty=format:"%C(yellow)%h%Creset %C(cyan)%an%Creset %s %C(green)(%cr)%Creset"'

# ============================================================
#  tmux — so easy a 5-year-old can use it 🧸
# ============================================================
alias work='tmux new-session -A -s main'
alias ta='tmux attach || tmux new -s main'
alias tl='tmux list-sessions'
alias tn='tmux new -s'
alias bye='tmux detach'
alias killall-tmux='tmux kill-server'
alias panes='tmux split-window -h'
alias rows='tmux split-window -v'
alias tabs='tmux new-window'

# ============================================================
#  Claude Code shortcut
# ============================================================
alias cc='claude'

# ============================================================
#  helpme — friendly cheat sheet
# ============================================================
helpme() {
cat <<'EOF'

  🧸  YOUR SUPER-SIMPLE TERMINAL CHEAT SHEET
  ==========================================

  GETTING AROUND
    ll            list everything (sizes, dates, git status, colors)
    ..            go up one folder      ...  go up two
    <foldername>  just type it to enter it (autocd)
    z <name>      jump to a folder you've visited before (zoxide)

  TMUX  (split screens that survive disconnects)  — prefix is Ctrl-a
    work          start / jump into your workspace
    Ctrl-a  |     split LEFT | RIGHT      Ctrl-a  -   split TOP / BOTTOM
    Ctrl-a  c     new tab (window)        Alt+arrows  hop between panes
    bye           step out (keeps running in background)
    killall-tmux  stop every tmux session

  GIT (prompt shows branch + status automatically)
    gs   status        ga <file>  stage a file      gaa  stage all
    gc "msg"  commit   gp  push    gpl  pull         gl   pretty log

  SEARCH
    Ctrl-R        fuzzy search your command history (atuin/fzf)
    Ctrl-T        fuzzy-pick a file into the command line (fzf)

  CLAUDE CODE
    cc            launch Claude Code (or type: claude)

  OTHER
    reload        reload this config after edits
    helpme        show this sheet again

EOF
}

# ============================================================
#  Bash completion
# ============================================================
if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        . /etc/bash_completion
    fi
fi

# ============================================================
#  Welcome banner (first shell of the session)
# ============================================================
if [ -z "$__WELCOMED" ]; then
    export __WELCOMED=1
    echo -e "\e[1;36m"
    echo "  ┌────────────────────────────────────────────┐"
    echo "  │  Welcome back, control  🐧                   │"
    echo "  │  Type 'helpme' for your cheat sheet          │"
    echo "  │  Type 'work' to start tmux · 'cc' for Claude │"
    echo "  └────────────────────────────────────────────┘"
    echo -e "\e[0m"
fi

# ============================================================
#  STARSHIP — must be LAST so it wraps the final PROMPT_COMMAND.
#  Falls back to the built-in git prompt if starship isn't installed.
# ============================================================
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
else
    PROMPT_COMMAND="__set_prompt${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
fi
